{
  "manifest_version": 2,
  "version": "0.1.1",
  "name": "Telegram Full Adapter",
  "description": "基于 Telethon (MTProto) 的 Telegram 全功能适配器，支持 Bot 与用户账号",
  "author": {
    "name": "KumaTea",
    "url": "https://github.com/KumaTea"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/KumaTea/MaiBot-Telegram-Full",
    "homepage": "https://github.com/KumaTea/MaiBot-Telegram-Full",
    "documentation": "https://github.com/KumaTea/MaiBot-Telegram-Full/blob/main/README.md",
    "issues": "https://github.com/KumaTea/MaiBot-Telegram-Full/issues"
  },
  "host_application": {
    "min_version": "1.2.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.8.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "telethon",
      "version_spec": ">=1.45,<2"
    },
    {
      "type": "python_package",
      "name": "cryptg",
      "version_spec": ">=0.4"
    },
    {
      "type": "python_package",
      "name": "markdown-it-py",
      "version_spec": ">=3.0"
    },
    {
      "type": "python_package",
      "name": "python-socks",
      "version_spec": ">=2.4"
    },
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=9.0"
    },
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.8"
    },
    {
      "type": "python_package",
      "name": "av",
      "version_spec": ">=12"
    }
  ],
  "capabilities": [
    "database.get",
    "chat.get_all_streams",
    "maisaka.context.append",
    "component.enable",
    "component.disable"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN",
      "en-US"
    ]
  },
  "id": "kumatea.telegram-full",
  "plugin_type": "adapter",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.svg"
    }
  },
  "changelog": "CHANGELOG.md"
}
